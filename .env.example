# ============================================================
#  Modèle de configuration — AUCUNE VRAIE CLÉ ICI.
#
#  En local  : copier en .env.local à la racine du dossier site/
#  En ligne  : saisir ces variables dans Vercel > Settings >
#              Environment Variables
#
#  .env.local n'est jamais versionné (voir .gitignore). Une clé
#  secrète Stripe qui part sur un dépôt est à révoquer aussitôt.
# ============================================================

# --- Stripe -------------------------------------------------
# Tableau de bord Stripe > Développeurs > Clés API.
# Commencer par les clés de TEST (sk_test_…) : elles permettent de
# tout vérifier avec la carte 4242 4242 4242 4242 sans encaisser.
STRIPE_SECRET_KEY=sk_test_a_remplacer

# Donné à la création du webhook (Stripe > Développeurs > Webhooks),
# ou affiché par `stripe listen` en local. Différent en test et en live.
STRIPE_WEBHOOK_SECRET=whsec_a_remplacer

# --- Notification de l'hôte ---------------------------------
# resend.com > API Keys
RESEND_API_KEY=re_a_remplacer

# L'adresse qui reçoit les commandes. C'est ce message que l'hôte
# transfère à la personne qui prépare la chambre.
HOST_NOTIFY_EMAIL=adresse@exemple.fr

# Coordonnées reprises en pied des mails envoyés aux clients.
# Sans CONTACT_EMAIL, les réponses arrivent sur HOST_NOTIFY_EMAIL.
CONTACT_EMAIL=
CONTACT_TEL=

# ⚠️ BLOQUANT POUR LES MAILS CLIENTS.
# Tant qu'aucun domaine n'est vérifié chez Resend, l'expéditeur reste
# onboarding@resend.dev et Resend n'accepte d'envoyer QU'À l'adresse du
# compte Resend. Les mails à l'hôte passent (mettre exactement cette
# adresse dans HOST_NOTIFY_EMAIL), mais AUCUN mail client n'arrivera :
# ni la confirmation de réservation, ni le code de la roue.
# Vérifier un domaine chez Resend est donc obligatoire avant d'ouvrir,
# puis mettre ici une adresse de ce domaine.
RESEND_FROM=INTENSE MANS <onboarding@resend.dev>

# --- Tableau de préparation ---------------------------------
# Mot de passe unique protégeant /preparer.html. À générer au hasard
# et à ne pas réutiliser ailleurs, par exemple :
#   openssl rand -base64 24
# Adresse(s) autorisées à ouvrir le tableau de bord, séparées par
# des virgules. C'est la SEULE clé du système : l'hôte tape son
# adresse sur /preparer.html, reçoit un lien valable 15 minutes et
# utilisable une seule fois, puis reste connecté 7 jours.
# Aucun mot de passe n'existe, donc rien à voler ni à forcer.
# Sans valeur, HOST_NOTIFY_EMAIL fait office d'adresse autorisée.
ADMIN_EMAILS=

# Repli, le temps que Resend soit branché : un secret partagé accepté
# en plus de la session. Le générer au hasard, ne jamais le réutiliser :
#   openssl rand -base64 24
# À vider une fois la connexion par lien vérifiée.
PREPARER_SECRET=a_remplacer_par_une_valeur_aleatoire

# --- Réservation de la chambre ------------------------------
# ⚠️ UNE GRILLE PROVISOIRE EST EN DUR dans site/api/_lib/rates.js :
# 99 € en semaine, 139 € le vendredi, 149 € le samedi, majorations de
# saison et remise de dernière minute. Ce sont des ordres de grandeur
# du marché, PAS les prix de l'exploitant. À valider avant d'ouvrir.
#
# Poser TARIF_SEMAINE court-circuite toute la grille et impose un
# tarif unique. Laisser vide pour garder la grille.
TARIF_SEMAINE=
# Appliqué au vendredi et au samedi si TARIF_SEMAINE est posé.
TARIF_WEEKEND=
# Nombre de nuits minimum par séjour (1 par défaut).
NUITS_MIN=1

# Calendrier Airbnb à lire, pour que les nuits vendues là-bas se
# grisent sur le site. Dans Airbnb : Calendrier > Disponibilités >
# Synchroniser les calendriers > Exporter le calendrier.
AIRBNB_ICAL_URL=

# Dans l'autre sens, RIEN à configurer : coller l'adresse
#   https://<le-domaine>/api/calendar
# dans Airbnb > Synchroniser les calendriers > Importer un calendrier.

# Airbnb ne relit le calendrier importé que toutes les 3 heures.
# En deçà de ce nombre de jours avant l'arrivée, la réservation est
# encaissée mais marquée « à valider » : l'hôte vérifie Airbnb puis
# confirme. C'est ce qui ferme la fenêtre de double réservation.
DELAI_CONFIRMATION_JOURS=3

# --- Base des commandes -------------------------------------
# NE PAS remplir à la main en production : ajouter l'intégration
# Upstash Redis depuis Vercel > Storage, elle injecte ces deux
# variables automatiquement. Les recopier ici pour le développement
# local avec `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
